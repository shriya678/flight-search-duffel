# Duffel access token. Use a TEST token (starts with duffel_test_) during development.
# Get one at https://app.duffel.com -> Developers -> Access tokens
DUFFEL_ACCESS_TOKEN=duffel_test_replace_me

PORT=5000

# Currency shown to users. Duffel prices are converted using ECB rates (default INR).
DISPLAY_CURRENCY=INR
